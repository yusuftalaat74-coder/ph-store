# Copy to .env beside docker-compose.yml and fill in. Never commit .env.
#
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=
JWT_SECRET=

# Host port the API listens on. Change it if 8099 is taken on this box.
API_PORT=8099

# Browser origins allowed to call the API. "*" is required while the Android
# client is the only consumer: its page loads from file:///android_asset/, so
# its Origin is the literal string `null`, which only a wildcard matches.
# Safe here because this API uses a Bearer header and never a cookie.
CORS_ORIGINS=*
